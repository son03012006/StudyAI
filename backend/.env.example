PORT=5000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=studyai_db

# JWT Authentication
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Ollama Local AI (KHÔNG dùng Gemini/OpenAI API)
# 1. Cài Ollama: https://ollama.com/download
# 2. Chạy server: ollama serve
# 3. Tải model:   ollama pull qwen2.5:3b
# 4. Tải model embedding: ollama pull nomic-embed-text
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Python local AI Service for embeddings, OCR, fine-tuned QA, and Ollama generation.
# Start from ai_service: python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=600000
AI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
